# Copy this file to .env and fill in the values. .env is gitignored.

# Vultr account API key (Console -> Account -> API). Used to create/manage the VM.
VULTR_API_KEY=

# Vultr Serverless Inference key (Console -> Serverless -> Inference). Used for agent LLM calls.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Optional: pin models (otherwise picked from /v1/models, Red and Blue from different families)
RED_MODEL=
BLUE_MODEL=
MANAGER_MODEL=

# Sandbox (set automatically by deploy/setup.sh)
SANDBOX_RUNTIME=
# Dev only, never in production: run the bundled demo repo without Docker (results labelled UNSANDBOXED)
VULNIGO_ALLOW_UNSANDBOXED_DEMO=
