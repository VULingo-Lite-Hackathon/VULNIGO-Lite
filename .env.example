# Backend process only. Never passed into a sandbox, never read by a container.
# Copy to /etc/vulnigo/vulnigo.env, owned root:vulnigo mode 640 -- systemd reads it
# as root before it drops privileges, and 600 makes the service fail to start.

# ---- read by agents/inference.py -----------------------------------------------
# Vultr Serverless Inference. Verify the live catalogue with:  python -m agents.smoke
VULNIGO_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULNIGO_INFERENCE_API_KEY=
VULNIGO_MODEL_RED=
VULNIGO_MODEL_BLUE=
VULNIGO_MODEL_MANAGER=

# Call discipline. Enforced before the request goes out, so a chatty agent cannot
# discover the credit ceiling in the middle of the demo.
VULNIGO_INFERENCE_TIMEOUT_S=45
VULNIGO_MAX_CALLS=24
VULNIGO_MAX_TOTAL_TOKENS=60000

# ---- read by backend/app/main.py -------------------------------------------------
VULNIGO_SANDBOX_BINARY=/usr/local/bin/vulnigo-sandbox

# ---- NOT read by anything yet ---------------------------------------------------
# The sandbox limits are hardcoded inside sandbox/vulnigo-sandbox on purpose: a
# compromised backend must not be able to loosen them with an environment variable.
# Change the constants in that file and re-run deploy.sh. Verify with:
#   sudo vulnigo-sandbox --print-config
VULNIGO_SANDBOX_NETWORK=none
VULNIGO_SANDBOX_MEMORY=512m
VULNIGO_SANDBOX_CPUS=1
VULNIGO_SANDBOX_PIDS=128
VULNIGO_SANDBOX_TIMEOUT=90

# Day 2 will enforce this in the intake code; today nothing reads it.
VULNIGO_ALLOWED_REPO_PREFIX=https://github.com/<org>/
